# ============================================================================
# Bayan ERP — متغيرات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم. لا تُلتزم ملفات .env الحقيقية بالمستودع.
# ============================================================================

# ---------------------------------------------------------------------------
# أساسي
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# قاعدة البيانات (PostgreSQL + PostGIS) — المنفذ 5433 لتجنب تعارض PostgreSQL المثبت على الجهاز
DATABASE_URL=postgresql://bayan:bayan@localhost:5433/bayan

# ---------------------------------------------------------------------------
# الأمان — مطلوبة إلزامياً في الإنتاج (الإقلاع يفشل بدونها)
# ---------------------------------------------------------------------------
# سر التوقيع للرموز (JWT): 16 حرفاً على الأقل، قيمة عشوائية قوية.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# مفتاح تشفير النسخ الاحتياطية: 64 خانة سِت عشرية (hex).
# توليد: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=

# كلمات مرور البذر الأولى (تُستخدم عند البذر/إعادة البذر فقط).
# مطلوبة إلزامياً في الإنتاج (لا قيم افتراضية ضعيفة). 8 أحرف على الأقل.
GLOBAL_ADMIN_PASSWORD=
ADMIN_PASSWORD=
REP_PASSWORD=

# ---------------------------------------------------------------------------
# Redis (BullMQ — التصدير والتقارير الثقيلة)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# تخزين الملفات (S3 متوافق — MinIO محلي)
# STORAGE_DRIVER: local | s3
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
# عند STORAGE_DRIVER=s3 (مطلوبة إلزامياً في الإنتاج):
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=bayan
S3_SECRET_KEY=bayan12345
S3_BUCKET=bayan
S3_REGION=us-east-1

# مرادفات MinIO (يدعمها التطبيق أيضاً):
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=bayan

# ---------------------------------------------------------------------------
# الواجهة الأمامية (تُضمَّن وقت البناء) — عنوان API الظاهر للمتصفح
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# أصول CORS المسموح بها (مفصولة بفواصل). مطلوبة في الإنتاج.
# مثال: CORS_ORIGINS=https://app.bayan.example
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# الإشعارات الفورية عبر FCM (اختياري — بدونها يعمل النقل في وضع no-op)
# ---------------------------------------------------------------------------
# FCM_SERVICE_ACCOUNT=            # JSON حساب الخدمة كسطر واحد
# FCM_SERVICE_ACCOUNT_FILE=       # أو مسار ملف JSON
# FCM_PROJECT_ID=

# ---------------------------------------------------------------------------
# النسخ الاحتياطي المجدول
# ---------------------------------------------------------------------------
BACKUP_DAILY_TIME=02:00
BACKUP_DIR=
PG_DUMP_PATH=
PG_PSQL_PATH=

# ---------------------------------------------------------------------------
# infra (docker-compose) — القيم الافتراضية للتطوير المحلي؛ غيّرها في الإنتاج.
# ---------------------------------------------------------------------------
POSTGRES_USER=bayan
POSTGRES_PASSWORD=bayan
POSTGRES_DB=bayan
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
