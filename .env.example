# قاعدة البيانات (PostgreSQL + PostGIS) — المنفذ 5433 لتجنب تعارض PostgreSQL المثبت على الجهاز
DATABASE_URL=postgresql://bayan:bayan@localhost:5433/bayan

# الخادم
PORT=3000
JWT_SECRET=change-me-in-production

# Redis (BullMQ — التصدير والتقارير الثقيلة)
REDIS_URL=redis://localhost:6379

# تخزين الملفات (S3 متوافق — MinIO محلي)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=bayan
S3_SECRET_KEY=bayan12345
S3_BUCKET=bayan

# infra (docker-compose) — القيم الافتراضية للتطوير المحلي؛ غيّرها في الإنتاج.
# يقرأها docker-compose.yml، ويقرأ تطبيق الـ API أسماء S3_* أعلاه.
POSTGRES_USER=bayan
POSTGRES_PASSWORD=bayan
POSTGRES_DB=bayan
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
