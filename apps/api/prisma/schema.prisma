// ============================================================
// Bayan ERP — نموذج البيانات الكامل
// مرجع: docs/bayan-design.md §7.3 + قرارات docs/PLAN.md
// ADR-1: period_id على كل جداول الحركات منذ البداية
// ADR-5: دفتر حسابات (Ledger) مدين/دائن
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================ الأنواع (Enums) ============================

enum UnitMeasurement {
  COUNT // عددي: أعداد صحيحة فقط
  WEIGHT // وزني: كسور حتى 3 خانات
}

enum CustomerClassification {
  A
  B
  C
}

enum WarehouseType {
  MAIN // رئيسي
  STEEL // حديد
  PAINT // بويات
  REP // عهدة مندوب
  DAMAGED // تالف
  SHOWROOM // معرض
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  RETURN_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  OPENING
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum StatementStatus {
  DRAFT // مسودة
  PENDING_REVIEW // بانتظار المراجعة (أوفلاين/تجاوز صلاحية)
  APPROVED // معتمد
  ARCHIVED // مرحّل للأرشيف
  CANCELLED // ملغي
}

enum PaymentTerm {
  CASH // نقدي
  CREDIT // آجل
  MIXED // مختلط
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHEQUE
  VODAFONE_CASH // فودافون كاش
  INSTAPAY // إنستاباي
  WALLET // محفظة (قديم — أُبقيت للتوافق مع البيانات السابقة)
}

enum ReturnMode {
  BY_CUSTOMER
  BY_REP
}

enum GoodsCondition {
  GOOD // صالح
  DAMAGED // تالف
}

enum ReturnReasonCode {
  DEFECT // عيب
  WRONG_ORDER // خطأ طلب
  DAMAGED // تلف
  OTHER // أخرى
}

enum ApprovalType {
  ITEM_DISCOUNT
  HEADER_DISCOUNT
  BELOW_COST
  BELOW_MIN_PRICE
  RETURN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PeriodStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum StocktakeStatus {
  OPEN
  COUNTING
  REVIEW
  APPROVED
  CLOSED
}

enum ChequeStatus {
  UNDER_COLLECTION
  COLLECTED
  RETURNED
}

enum LedgerAccountType {
  CUSTOMER
  SUPPLIER
  CASH
}

enum VisitStatus {
  DONE
  MISSED
}

enum CompanyStatus {
  ACTIVE
  DISABLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
  EXPIRED
}

enum CommissionBase {
  COLLECTED
  SALES
}

enum RepTargetPeriod {
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum BackupStatus {
  RUNNING
  DONE
  FAILED
}

enum ReturnSettlement {
  BALANCE // خصم من رصيد العميل
  CASH // رد نقدية
  CREDIT // رصيد دائن
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum TransferStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum CashAccountType {
  CASH
  BANK
  WALLET
}

enum VisitPlanStatus {
  PLANNED
  DONE
  MISSED
}

// ============================ المستخدمون والصلاحيات ============================

model Role {
  id     Int    @id @default(autoincrement())
  code   String @unique
  nameAr String
  // حدود الخصم الافتراضية للدور (تُغافل حد المستخدم عند ضبطها، §4.2)
  maxItemDiscountPct    Decimal? @db.Decimal(5, 2)
  maxInvoiceDiscountPct Decimal? @db.Decimal(5, 2)
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id     Int              @id @default(autoincrement())
  code   String           @unique // مثال: statement.create, discount.approve
  nameAr String
  roles  RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id                    Int      @id @default(autoincrement())
  name                  String
  phone                 String?  @unique
  email                 String?  @unique
  passwordHash          String
  roleId                Int
  role                  Role     @relation(fields: [roleId], references: [id])
  // الشركة المستأجر (SaaS) — فارغة غير مغطاة لشركة افتراضية عامة
  companyId             Int?
  company               Company? @relation(fields: [companyId], references: [id])
  // كود المندوب لترقيم البيانات أوفلاين (مثل M03)
  repCode               String?  @unique
  // حدود الخصم لكل مستخدم (تجاوزها يطلب موافقة)
  maxItemDiscountPct    Decimal  @default(0) @db.Decimal(5, 2)
  maxInvoiceDiscountPct Decimal  @default(0) @db.Decimal(5, 2)
  branchId              Int?
  branch                Branch?  @relation(fields: [branchId], references: [id])
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  createdStatements  PriceStatement[]     @relation("StatementCreatedBy")
  approvedStatements PriceStatement[]     @relation("StatementApprovedBy")
  repStatements      PriceStatement[]     @relation("StatementRep")
  returnStatements   ReturnStatement[]    @relation("ReturnRep")
  approvedReturns    ReturnStatement[]    @relation("ReturnApprovedBy")
  keptWarehouses     Warehouse[]
  customers          Customer[]           @relation("CustomerRep")
  priceChanges       PriceHistory[]
  auditLogs          AuditLog[]
  devices            DeviceRegistration[]
  openedStocktakes   StocktakeSession[]   @relation("StocktakeOpenedBy")
  approvedStocktakes StocktakeSession[]   @relation("StocktakeApprovedBy")
  stocktakeCounts    StocktakeLine[]      @relation("StocktakeCountedBy")
  decidedApprovals   Approval[]           @relation("ApprovalDecidedBy")
  requestedApprovals Approval[]           @relation("ApprovalRequestedBy")
  closedPeriods      Period[]
  shifts             RepShift[]
  featureOverrides   UserFeature[]
  consentRecords     ConsentRecord[]
  createdArchives    ArchiveRun[]         @relation("ArchiveCreatedBy")
  confirmedArchives  ArchiveRun[]         @relation("ArchiveConfirmedBy")
  createdQuotations  Quotation[]          @relation("QuotationCreatedBy")
  approvedQuotations Quotation[]          @relation("QuotationApprovedBy")
  repQuotations      Quotation[]          @relation("QuotationRep")
  repTargets         RepTarget[]
  specialPrices      SpecialPrice[]
  backups            AutomatedBackup[]
  notifications      Notification[]

  @@index([companyId])
  @@index([branchId])
}

// سجل الشركات (SaaS) — كل شركة مستأجر منفصل
model Company {
  id          Int           @id @default(autoincrement())
  code        String        @unique
  nameAr      String
  phone       String?
  email       String?
  contactName String?
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users    User[]
  features CompanyFeature[]
}

// مشرف عام للبيئة (خارج الشركات)
model GlobalAdmin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  nameAr       String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ميزات النظام (Feature Flags) — حالات الاستثناء للشركة/المستخدم
model SystemFeature {
  id               Int              @id @default(autoincrement())
  code             String           @unique
  nameAr           String
  enabled          Boolean          @default(true) // الحالة العامة (Global)
  userOverrides    UserFeature[]
  companyOverrides CompanyFeature[]
}

model CompanyFeature {
  companyId Int
  featureId Int
  enabled   Boolean
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature   SystemFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([companyId, featureId])
  @@index([featureId])
}

model UserFeature {
  userId    Int
  featureId Int
  enabled   Boolean
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   SystemFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([userId, featureId])
  @@index([featureId])
}

// ============================ الأصناف والوحدات والأسعار ============================

model Category {
  companyId Int?
  id       Int        @id @default(autoincrement())
  code     String
  nameAr   String
  nameEn   String?
  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  @@index([companyId])
  @@unique([companyId, code])
  items    Item[]
}

model Brand {
  companyId Int?
  id     Int    @id @default(autoincrement())
  code   String
  nameAr String
  @@index([companyId])
  @@unique([companyId, code])
  items  Item[]
}

model Unit {
  id                  Int                     @id @default(autoincrement())
  code                String                  @unique // kg, ton, bar, bag, carton...
  nameAr              String
  nameEn              String?
  measurement         UnitMeasurement
  itemUnits           ItemUnit[]
  baseItems           Item[]                  @relation("ItemBaseUnit")
  saleLines           PriceStatementLine[]
  returnLines         ReturnLine[]
  purchaseLines       PurchaseStatementLine[]
  quotationLines      QuotationLine[]
  specialPrices       SpecialPrice[]
  priceChanges        PriceHistory[]
  purchaseOrderLines  PurchaseOrderLine[]
  supplierReturnLines SupplierReturnLine[]
}

model Item {
  companyId Int?
  id               Int      @id @default(autoincrement())
  code             String
  barcode          String?
  nameAr           String
  nameEn           String?
  categoryId       Int
  category         Category @relation(fields: [categoryId], references: [id])
  brandId          Int?
  brand            Brand?   @relation(fields: [brandId], references: [id])
  origin           String?
  baseUnitId       Int
  baseUnit         Unit     @relation("ItemBaseUnit", fields: [baseUnitId], references: [id])
  trackBatch       Boolean  @default(false)
  minStock         Decimal  @default(0) @db.Decimal(18, 3)
  lastPurchaseCost Decimal? @db.Decimal(18, 4)
  // تاريخ آخر سعر شراء (§5.3)
  lastPurchaseAt   DateTime?
  // حد أدنى لسعر البيع للوحدة الأساسية (§5.3) — البيع دونه يتطلب موافقة استثناء
  minSalePrice     Decimal? @db.Decimal(18, 4)
  active           Boolean  @default(true)
  // الأصناف المتغيرة: صنف أساسي مع تنويعات (لون/عبوة...)
  parentItemId     Int?
  parent           Item?    @relation("ItemVariants", fields: [parentItemId], references: [id])
  variants         Item[]   @relation("ItemVariants")
  imageUrl         String?

  attributes          ItemAttribute[]
  itemUnits           ItemUnit[]
  prices              ItemPrice[]
  priceHistory        PriceHistory[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  stocktakeLines      StocktakeLine[]
  statementLines      PriceStatementLine[]
  returnLines         ReturnLine[]
  purchaseLines       PurchaseStatementLine[]
  quotationLines      QuotationLine[]
  specialPrices       SpecialPrice[]
  transferLines       StockTransferLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  supplierReturnLines SupplierReturnLine[]
  batches             Batch[]

  @@index([categoryId])
  @@index([companyId])
  @@index([nameAr])
  @@unique([companyId, code])
  @@unique([companyId, barcode])
}

// دفعات الأصناف (اختياري §5.1) — كود الدفعة + تواريخ الإنتاج/الصلاحية (للبويات مثلاً)
model Batch {
  companyId      Int?
  id             Int       @id @default(autoincrement())
  itemId         Int
  item           Item      @relation(fields: [itemId], references: [id])
  code           String
  productionDate DateTime? @db.Date
  expiry         DateTime? @db.Date
  notes          String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
  @@index([itemId])
  @@index([expiry])
  @@unique([companyId, itemId, code])
}

model ItemAttribute {
  id     Int    @id @default(autoincrement())
  itemId Int
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  key    String // قطر، طول، درجة، لون، سعة...
  value  String

  @@unique([itemId, key])
}

model ItemUnit {
  id           Int     @id @default(autoincrement())
  itemId       Int
  item         Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitId       Int
  unit         Unit    @relation(fields: [unitId], references: [id])
  factorToBase Decimal @db.Decimal(18, 6) // معامل التحويل للوحدة الأساسية
  barcode      String? @unique
  isSale       Boolean @default(true)
  isPurchase   Boolean @default(true)
  allowDecimal Boolean @default(true)

  @@unique([itemId, unitId])
}

model PriceList {
  companyId Int?
  id            Int            @id @default(autoincrement())
  code          String
  nameAr        String
  active        Boolean        @default(true)
  customers     Customer[]
  prices        ItemPrice[]
  priceChanges  PriceHistory[]
  @@index([companyId])
  @@unique([companyId, code])
  specialPrices SpecialPrice[]
}

model ItemPrice {
  companyId Int?
  id          Int       @id @default(autoincrement())
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitId      Int
  priceListId Int
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  price       Decimal   @db.Decimal(18, 4)
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  createdAt   DateTime  @default(now())

  // R3-A7 (§5.3): many rows per (item, unit, list) so a scheduled price can
  // coexist with the current one; resolver picks by validFrom/validTo window.
  @@index([itemId, unitId, priceListId, validFrom])
  @@index([companyId])
  @@index([priceListId])
}

model PriceHistory {
  companyId Int?
  id          Int        @id @default(autoincrement())
  itemId      Int
  item        Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitId      Int
  unit        Unit       @relation(fields: [unitId], references: [id])
  priceListId Int?
  priceList   PriceList? @relation(fields: [priceListId], references: [id])
  oldPrice    Decimal?   @db.Decimal(18, 4)
  newPrice    Decimal    @db.Decimal(18, 4)
  changedById Int
  changedBy   User       @relation(fields: [changedById], references: [id])
  changedAt   DateTime   @default(now())

  @@index([companyId])
  @@index([itemId, changedAt])
}

// ============================ العملاء والموردون ============================

model Customer {
  companyId Int?
  id             Int                    @id @default(autoincrement())
  code           String
  nameAr         String
  nameEn         String?
  activity       String?
  address        String?
  lat            Decimal?               @db.Decimal(10, 7)
  lng            Decimal?               @db.Decimal(10, 7)
  phone          String?
  phone2         String?
  taxNumber      String?
  priceListId    Int
  priceList      PriceList              @relation(fields: [priceListId], references: [id])
  creditLimit    Decimal                @default(0) @db.Decimal(18, 2)
  creditDays     Int                    @default(0)
  repId          Int?
  rep            User?                  @relation("CustomerRep", fields: [repId], references: [id])
  openingBalance Decimal                @default(0) @db.Decimal(18, 2)
  classification CustomerClassification @default(C)
  // تقييم السداد (0-100): يُحدَّث يدوياً أو آلياً حسب الالتزام بالسداد
  paymentRating  Int?
  paymentNotes   String?
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  statements      PriceStatement[]
  returns         ReturnStatement[]
  receipts        Receipt[]
  cheques         Cheque[]
  assignments     CustomerRepAssignment[]
  visits          RepVisit[]
  quotations      Quotation[]
  specialPrices   SpecialPrice[]
  customerGroupId Int?
  customerGroup   CustomerGroup?          @relation(fields: [customerGroupId], references: [id])
  visitPlanLines  VisitPlanLine[]

  @@index([repId])
  @@index([nameAr])
  @@index([companyId])
  @@index([customerGroupId])
  @@unique([companyId, code])
}

model CustomerRepAssignment {
  companyId Int?
  id         Int       @id @default(autoincrement())
  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  repId      Int
  fromDate   DateTime  @default(now())
  toDate     DateTime?

  @@index([companyId])
  @@index([repId, fromDate])
}

model Supplier {
  companyId Int?
  id             Int      @id @default(autoincrement())
  code           String
  nameAr         String
  phone          String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchases       PurchaseStatement[]
  payments        Payment[]
  cheques         Cheque[]
  purchaseOrders  PurchaseOrder[]
  @@index([companyId])
  @@unique([companyId, code])
  supplierReturns SupplierReturn[]
}

// ============================ المخازن والمخزون ============================

model Warehouse {
  companyId Int?
  id       Int           @id @default(autoincrement())
  code     String
  nameAr   String
  type     WarehouseType @default(MAIN)
  keeperId Int?
  keeper   User?         @relation(fields: [keeperId], references: [id])
  branchId Int?
  branch   Branch?       @relation(fields: [branchId], references: [id])
  active   Boolean       @default(true)

  balances        StockBalance[]
  movements       StockMovement[]
  statements      PriceStatement[]
  purchases       PurchaseStatement[]
  stocktakes      StocktakeSession[]
  quotations      Quotation[]
  transfersOut    StockTransfer[]     @relation("TransferFrom")
  transfersIn     StockTransfer[]     @relation("TransferTo")
  purchaseOrders  PurchaseOrder[]
  supplierReturns SupplierReturn[]

  @@index([companyId])
  @@index([branchId])
  @@unique([companyId, code])
}

model StockBalance {
  companyId Int?
  warehouseId Int
  itemId      Int
  // فارغ ("") = بدون تشغيلة
  batchId     String   @default("")
  qtyBase     Decimal  @db.Decimal(18, 3)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@id([warehouseId, itemId, batchId])
  @@index([companyId])
  @@index([itemId])
}

model StockMovement {
  companyId Int?
  id          Int               @id @default(autoincrement())
  type        StockMovementType
  warehouseId Int
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  itemId      Int
  item        Item              @relation(fields: [itemId], references: [id])
  batchId     String            @default("")
  // موجب = وارد، سالب = منصرف
  qtyBase     Decimal           @db.Decimal(18, 3)
  cost        Decimal?          @db.Decimal(18, 4)
  refType     String? // price_statement, purchase, return, stocktake...
  refId       Int?
  userId      Int?
  // ADR-1: كل حركة تنتمي لفترة (null = الفترة الحالية المفتوحة)
  periodId    Int?
  period      Period?           @relation(fields: [periodId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([warehouseId, itemId, createdAt])
  @@index([refType, refId])
  @@index([companyId])
  @@index([periodId])
}

// ============================ الأرشفة والترحيل (ADR-1) ============================

// حجز مؤقت للكميات (اختياري §5.7): مسودة بيان تحجز الكمية حتى الاعتماد أو الإلغاء
model StockReservation {
  companyId Int?
  id          Int       @id @default(autoincrement())
  refType     String    @default("price_statement")
  refId       Int
  itemId      Int
  warehouseId Int
  batchId     String    @default("")
  qtyBase     Decimal   @db.Decimal(18, 3)
  status      String    @default("ACTIVE") // ACTIVE | RELEASED
  createdAt   DateTime  @default(now())
  releasedAt  DateTime?

  @@index([warehouseId, itemId, status])
  @@index([companyId])
  @@index([refType, refId, status])
}

model Period {
  companyId Int?
  id          Int          @id @default(autoincrement())
  fromDate    DateTime     @db.Date
  toDate      DateTime     @db.Date
  status      PeriodStatus @default(OPEN)
  archiveFile String?
  checksum    String? // SHA-256 لحزمة الأرشيف
  closedById  Int?
  closedBy    User?        @relation(fields: [closedById], references: [id])
  closedAt    DateTime?
  createdAt   DateTime     @default(now())

  movements  StockMovement[]
  statements PriceStatement[]
  returns    ReturnStatement[]
  purchases  PurchaseStatement[]
  ledger     LedgerEntry[]
  stocktakes StocktakeSession[]
  archives   ArchiveRun[]
  quotations Quotation[]

  @@index([companyId])
  @@index([status])
}

// ============================ الترحيل والأرشفة (§5.11) ============================

enum ArchiveRunStatus {
  PRECHECKS
  READY
  CONFIRMED
  RESTORED
  FAILED
}

model ArchiveRun {
  id            Int              @id @default(autoincrement())
  code          String           @unique // AR-000001
  fromDate      DateTime         @db.Date
  toDate        DateTime         @db.Date
  status        ArchiveRunStatus @default(PRECHECKS)
  checks        Json? // نتيجة فحوصات ما قبل الترحيل
  manifest      Json? // manifest الحزمة (الإجماليات + checksums)
  counts        Json? // أعداد المحذوف/المصرّف
  bundlePath    String? // مسار ملف .zip على القرص
  bundleSha256  String? // SHA-256 للحزمة كاملة
  backupPath    String? // نسخة احتياطية كاملة قبل الحذف
  note          String?
  periodId      Int?
  period        Period?          @relation(fields: [periodId], references: [id])
  createdById   Int?
  createdBy     User?            @relation("ArchiveCreatedBy", fields: [createdById], references: [id])
  confirmedById Int?
  confirmedBy   User?            @relation("ArchiveConfirmedBy", fields: [confirmedById], references: [id])
  createdAt     DateTime         @default(now())
  confirmedAt   DateTime?
  restoredAt    DateTime?

  openingBalances OpeningBalance[]

  @@index([status])
}

enum OpeningBalanceKind {
  CUSTOMER
  SUPPLIER
  ITEM
  CASH
}

// أرصدة افتتاحية للفترة الجديدة بعد التدوير (§5.11 الخطوة 7)
model OpeningBalance {
  companyId Int?
  id          Int                @id @default(autoincrement())
  runId       Int
  run         ArchiveRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind        OpeningBalanceKind
  accountId   Int                @default(0) // customer/supplier id (0 للنقدية)
  itemId      Int?
  warehouseId Int?
  amount      Decimal            @default(0) @db.Decimal(18, 2)
  qtyBase     Decimal?           @db.Decimal(18, 3)
  createdAt   DateTime           @default(now())

  @@index([kind])
  @@index([companyId])
  @@index([runId])
}

// ============================ ترقيم آمن أوفلاين ============================

model NumberBlock {
  companyId Int?
  id        Int      @id @default(autoincrement())
  prefix    String // BP, PR, RT, RC, PV, ST
  ownerCode String // كود المندوب أو "" للمكتب
  period    Int      @default(0) // سنة/فترة الترقيم (0 = بلا فترة، السلوك الافتراضي)
  fromNo    Int
  toNo      Int
  lastUsed  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([companyId, prefix, ownerCode, period, fromNo])
  @@index([companyId])
  @@index([prefix, ownerCode, period])
}

// ============================ بيان الأسعار ============================

model PriceStatement {
  companyId Int?
  id             Int             @id @default(autoincrement())
  number         String // BP-M03-000127
  clientUuid     String // معرّف الجهاز — يمنع التكرار أوفلاين
  customerId     Int
  customer       Customer        @relation(fields: [customerId], references: [id])
  repId          Int?
  rep            User?           @relation("StatementRep", fields: [repId], references: [id])
  warehouseId    Int
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  date           DateTime        @default(now())
  status         StatementStatus @default(DRAFT)
  paymentTerm    PaymentTerm     @default(CREDIT)
  subtotal       Decimal         @db.Decimal(18, 2)
  discountType   DiscountType?
  discountValue  Decimal?        @db.Decimal(18, 2)
  discountAmount Decimal         @default(0) @db.Decimal(18, 2)
  shipping       Decimal         @default(0) @db.Decimal(18, 2)
  taxPercent     Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(18, 2)
  net            Decimal         @db.Decimal(18, 2)
  paid           Decimal         @default(0) @db.Decimal(18, 2)
  lat            Decimal?        @db.Decimal(10, 7)
  lng            Decimal?        @db.Decimal(10, 7)
  notes          String?
  createdById    Int
  createdBy      User            @relation("StatementCreatedBy", fields: [createdById], references: [id])
  approvedById   Int?
  approvedBy     User?           @relation("StatementApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  cancelReason   String?
  cancelledById  Int?
  cancelledAt    DateTime?
  // ADR-1 + ADR-6
  periodId       Int?
  period         Period?         @relation(fields: [periodId], references: [id])
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  lines         PriceStatementLine[]
  revisions     StatementRevision[]
  receiptAllocs ReceiptAllocation[]

  @@index([customerId, date])
  @@index([repId, date])
  @@index([periodId])
  @@index([companyId])
  @@index([status])
  @@unique([companyId, number])
  @@unique([companyId, clientUuid])
}

model PriceStatementLine {
  id                      Int            @id @default(autoincrement())
  statementId             Int
  statement               PriceStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  itemId                  Int
  item                    Item           @relation(fields: [itemId], references: [id])
  unitId                  Int
  unit                    Unit           @relation(fields: [unitId], references: [id])
  // لقطة معامل التحويل وقت البيع
  factor                  Decimal        @db.Decimal(18, 6)
  qty                     Decimal        @db.Decimal(18, 3)
  qtyBase                 Decimal        @db.Decimal(18, 3)
  unitPrice               Decimal        @db.Decimal(18, 4)
  lineDiscountType        DiscountType?
  lineDiscountValue       Decimal?       @db.Decimal(18, 2)
  lineDiscountAmount      Decimal        @default(0) @db.Decimal(18, 2)
  allocatedHeaderDiscount Decimal        @default(0) @db.Decimal(18, 2)
  netLine                 Decimal        @db.Decimal(18, 2)
  // لقطة التكلفة وقت البيع (للأرباح)
  costSnapshot            Decimal?       @db.Decimal(18, 4)
  weightNote              String? // الوزن الفعلي مقابل النظري (الحديد)
  returnLines             ReturnLine[]
  periodId                Int?
  createdAt               DateTime       @default(now())

  @@index([statementId])
  @@index([itemId])
}

model StatementRevision {
  id           Int            @id @default(autoincrement())
  statementId  Int
  statement    PriceStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  revisionNo   Int
  snapshotJson Json
  changedById  Int
  reason       String?
  createdAt    DateTime       @default(now())

  @@unique([statementId, revisionNo])
}

// ============================ المرتجعات ============================

model ReturnReason {
  id      Int               @id @default(autoincrement())
  code    ReturnReasonCode  @unique
  nameAr  String
  returns ReturnStatement[]
}

model ReturnStatement {
  companyId Int?
  id               Int              @id @default(autoincrement())
  number           String // RT-...
  clientUuid       String?
  mode             ReturnMode
  customerId       Int?
  customer         Customer?        @relation(fields: [customerId], references: [id])
  repId            Int?
  rep              User?            @relation("ReturnRep", fields: [repId], references: [id])
  date             DateTime         @default(now())
  status           StatementStatus  @default(DRAFT)
  total            Decimal          @db.Decimal(18, 2)
  // مرتجع بدون بيان أصلي (بصلاحية خاصة) — تقييم بسعر مُدخل
  withoutStatement Boolean          @default(false)
  // أثر المرتجع المالي
  settlement       ReturnSettlement @default(BALANCE)
  reasonId         Int?
  reason           ReturnReason?    @relation(fields: [reasonId], references: [id])
  notes            String?
  createdById      Int?
  approvedById     Int?
  approvedBy       User?            @relation("ReturnApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  periodId         Int?
  period           Period?          @relation(fields: [periodId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lines ReturnLine[]

  @@index([customerId, date])
  @@index([repId, date])
  @@index([companyId])
  @@index([periodId])
  @@unique([companyId, number])
  @@unique([companyId, clientUuid])
}

model ReturnLine {
  id           Int                 @id @default(autoincrement())
  returnId     Int
  return       ReturnStatement     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  // المرجع لبند البيع الأصلي — أساس التسعير
  sourceLineId Int?
  sourceLine   PriceStatementLine? @relation(fields: [sourceLineId], references: [id])
  itemId       Int
  item         Item                @relation(fields: [itemId], references: [id])
  unitId       Int
  unit         Unit                @relation(fields: [unitId], references: [id])
  qty          Decimal             @db.Decimal(18, 3)
  qtyBase      Decimal             @db.Decimal(18, 3)
  unitNetPrice Decimal             @db.Decimal(18, 4) // صافي البند الأصلي ÷ كميته
  lineTotal    Decimal             @db.Decimal(18, 2)
  condition    GoodsCondition      @default(GOOD)
  periodId     Int?

  @@index([returnId])
  @@index([sourceLineId])
}

// ============================ المشتريات (بيان التوريد) ============================

model PurchaseStatement {
  companyId Int?
  id              Int             @id @default(autoincrement())
  number          String // PR-...
  clientUuid      String?
  supplierId      Int
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  warehouseId     Int
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  date            DateTime        @default(now())
  status          StatementStatus @default(DRAFT)
  subtotal        Decimal         @db.Decimal(18, 2)
  discountType    DiscountType?
  discountValue   Decimal?        @db.Decimal(18, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(18, 2)
  shipping        Decimal         @default(0) @db.Decimal(18, 2)
  net             Decimal         @db.Decimal(18, 2)
  // أمر الشراء المرتبط (اختياري) + إجمالي مصاريف النقل الموزّعة
  orderId         Int?
  landedCostTotal Decimal?        @db.Decimal(18, 2)
  paid            Decimal         @default(0) @db.Decimal(18, 2)
  notes           String?
  periodId        Int?
  period          Period?         @relation(fields: [periodId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lines PurchaseStatementLine[]
  paymentAllocs PaymentAllocation[]

  @@index([supplierId, date])
  @@index([companyId])
  @@index([periodId])
  @@unique([companyId, number])
  @@unique([companyId, clientUuid])
}

model PurchaseStatementLine {
  id                 Int               @id @default(autoincrement())
  statementId        Int
  statement          PurchaseStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  itemId             Int
  item               Item              @relation(fields: [itemId], references: [id])
  unitId             Int
  unit               Unit              @relation(fields: [unitId], references: [id])
  factor             Decimal           @db.Decimal(18, 6)
  qty                Decimal           @db.Decimal(18, 3)
  qtyBase            Decimal           @db.Decimal(18, 3)
  unitPrice          Decimal           @db.Decimal(18, 4)
  lineDiscountType   DiscountType?
  lineDiscountValue  Decimal?          @db.Decimal(18, 2)
  lineDiscountAmount Decimal           @default(0) @db.Decimal(18, 2)
  netLine            Decimal           @db.Decimal(18, 2)
  // التكلفة النهائية بعد توزيع مصاريف النقل (Landed Cost) — اختياري
  landedCost         Decimal?          @db.Decimal(18, 4)
  // كود الدفعة المستلمة (لأصناف تتتبع الدفعات §5.1) — فارغ = بدون دفعة
  batchId            String            @default("")
  periodId           Int?

  @@index([statementId])
}

// ============================ التحصيل والخزينة ============================

model Receipt {
  companyId Int?
  id         Int           @id @default(autoincrement())
  number     String // RC-...
  clientUuid String? // معرّف الجهاز — يمنع التكرار أوفلاين
  customerId Int
  customer   Customer      @relation(fields: [customerId], references: [id])
  amount     Decimal       @db.Decimal(18, 2)
  method     PaymentMethod @default(CASH)
  receivedAt DateTime      @default(now())
  notes      String?
  lat        Decimal?      @db.Decimal(10, 7)
  lng        Decimal?      @db.Decimal(10, 7)
  chequeId   Int?
  cheque     Cheque?       @relation(fields: [chequeId], references: [id])
  cashAccountId Int?
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])
  periodId   Int?
  createdAt  DateTime      @default(now())

  allocations ReceiptAllocation[]

  @@index([companyId])
  @@index([cashAccountId])
  @@index([customerId, receivedAt])
  @@unique([companyId, number])
  @@unique([companyId, clientUuid])
}

model ReceiptAllocation {
  id          Int            @id @default(autoincrement())
  receiptId   Int
  receipt     Receipt        @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  statementId Int
  statement   PriceStatement @relation(fields: [statementId], references: [id])
  amount      Decimal        @db.Decimal(18, 2)

  @@unique([receiptId, statementId])
}

model PaymentAllocation {
  id                  Int               @id @default(autoincrement())
  paymentId           Int
  payment             Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchaseStatementId Int
  statement           PurchaseStatement @relation(fields: [purchaseStatementId], references: [id])
  amount              Decimal           @db.Decimal(18, 2)

  @@unique([paymentId, purchaseStatementId])
}

model Payment {
  companyId Int?
  id         Int           @id @default(autoincrement())
  number     String // PV-...
  supplierId Int
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  amount     Decimal       @db.Decimal(18, 2)
  method     PaymentMethod @default(CASH)
  paidAt     DateTime      @default(now())
  notes      String?
  chequeId   Int?
  cheque     Cheque?       @relation(fields: [chequeId], references: [id])
  cashAccountId Int?
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])
  periodId   Int?
  createdAt  DateTime      @default(now())

  allocations PaymentAllocation[]

  @@index([companyId])
  @@index([cashAccountId])
  @@index([supplierId, paidAt])
  @@unique([companyId, number])
}

model Cheque {
  id          Int          @id @default(autoincrement())
  number      String
  bankName    String
  dueDate     DateTime     @db.Date
  amount      Decimal      @db.Decimal(18, 2)
  status      ChequeStatus @default(UNDER_COLLECTION)
  customerId  Int?
  customer    Customer?    @relation(fields: [customerId], references: [id])
  supplierId  Int?
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  receivedAt  DateTime     @default(now())
  collectedAt DateTime?
  createdAt   DateTime     @default(now())
  companyId   Int?

  receipts Receipt[]
  payments Payment[]

  @@index([status, dueDate])
  @@index([companyId])
}

// ============================ الموافقات ============================

model Approval {
  companyId Int?
  id            Int            @id @default(autoincrement())
  type          ApprovalType
  refType       String // price_statement, return_statement
  refId         Int
  refJson       Json? // نسخة من الطلب للمراجعة
  requestedById Int
  requestedBy   User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  status        ApprovalStatus @default(PENDING)
  decidedById   Int?
  decidedBy     User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  note          String?
  createdAt     DateTime       @default(now())

  @@index([companyId])
  @@index([status, type])
}

// ============================ دفتر الحسابات (ADR-5) ============================

model LedgerEntry {
  companyId Int?
  id          Int               @id @default(autoincrement())
  periodId    Int?
  period      Period?           @relation(fields: [periodId], references: [id])
  entryDate   DateTime          @db.Date
  accountType LedgerAccountType
  // معرّف الحساب (customer.id أو supplier.id)
  accountId   Int
  debit       Decimal           @default(0) @db.Decimal(18, 2)
  credit      Decimal           @default(0) @db.Decimal(18, 2)
  refType     String? // price_statement, receipt, payment, return...
  refId       Int?
  description String?
  createdAt   DateTime          @default(now())

  @@index([accountType, accountId, entryDate])
  @@index([companyId])
  @@index([periodId])
}

// ============================ الجرد ============================

model StocktakeSession {
  companyId Int?
  id           Int             @id @default(autoincrement())
  number       String // ST-...
  warehouseId  Int
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  status       StocktakeStatus @default(OPEN)
  // كلي أو جزئي (فلتر تصنيف/ماركة/مجموعة أصناف)
  scopeJson    Json?
  openedById   Int
  openedBy     User            @relation("StocktakeOpenedBy", fields: [openedById], references: [id])
  approvedById Int?
  approvedBy   User?           @relation("StocktakeApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  openedAt     DateTime        @default(now())
  closedAt     DateTime?
  notes        String?
  periodId     Int?
  period       Period?         @relation(fields: [periodId], references: [id])

  lines StocktakeLine[]

  @@index([companyId])
  @@index([warehouseId, status])
  @@unique([companyId, number])
}

model StocktakeLine {
  id             Int              @id @default(autoincrement())
  sessionId      Int
  session        StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemId         Int
  item           Item             @relation(fields: [itemId], references: [id])
  batchId        String           @default("")
  // لقطة رصيد النظام وقت فتح الجلسة (Snapshot)
  systemQtyBase  Decimal          @db.Decimal(18, 3)
  countedQtyBase Decimal?         @db.Decimal(18, 3)
  diffQty        Decimal?         @db.Decimal(18, 3)
  lastCost       Decimal?         @db.Decimal(18, 4)
  diffValue      Decimal?         @db.Decimal(18, 2)
  recountCount   Int              @default(0)
  // دعم أكثر من عداد (§5.8.3): معرّف/اسم العداد وآخر من أدخل العد
  counter        String?
  countedById    Int?
  countedBy      User?            @relation("StocktakeCountedBy", fields: [countedById], references: [id])

  @@unique([sessionId, itemId, batchId])
}

// ============================ الإعدادات ============================

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================ تطبيق المناديب (المرحلة 4-5) ============================

model DeviceRegistration {
  companyId Int?
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  deviceName String?
  active     Boolean   @default(true)
  lastSeenAt DateTime?
  @@index([companyId])
  @@unique([companyId, deviceId])
  createdAt  DateTime  @default(now())
}

model RepShift {
  companyId Int?
  id        Int       @id @default(autoincrement())
  repId     Int
  rep       User      @relation(fields: [repId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  startLat  Decimal?  @db.Decimal(10, 7)
  startLng  Decimal?  @db.Decimal(10, 7)
  endLat    Decimal?  @db.Decimal(10, 7)
  endLng    Decimal?  @db.Decimal(10, 7)

  locations RepLocation[]
  visits    RepVisit[]

  @@index([companyId])
  @@index([repId, startedAt])
}

model RepLocation {
  companyId Int?
  id         Int      @id @default(autoincrement())
  repId      Int
  shiftId    Int
  shift      RepShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  accuracy   Decimal? @db.Decimal(8, 2)
  battery    Int?
  capturedAt DateTime @default(now())

  @@index([companyId])
  @@index([repId, capturedAt])
}

model RepVisit {
  companyId Int?
  id         Int         @id @default(autoincrement())
  repId      Int
  shiftId    Int?
  shift      RepShift?   @relation(fields: [shiftId], references: [id])
  customerId Int
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     VisitStatus
  reason     String?
  lat        Decimal?    @db.Decimal(10, 7)
  lng        Decimal?    @db.Decimal(10, 7)
  at         DateTime    @default(now())

  @@index([companyId])
  @@index([repId, at])
}

// ============================ إقرارات الموافقة ============================

// §5.13 إقرار/موافقة موقّعة على تتبع الموقع أثناء الوردية (قانون حماية
// البيانات المصري 151/2020). يُحفظ نص النسخة واسم المُوقِّع للتدقيق.
model ConsentRecord {
  companyId     Int?
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  type          String // GEO_TRACKING
  version       String // نسخة نص الإقرار (مثل 1.0)
  signatureName String // الاسم الكامل المُوقِّع كما كتبه
  deviceId      String?
  acceptedAt    DateTime @default(now())
  revokedAt     DateTime?

  @@index([companyId])
  @@index([userId, type, acceptedAt])
}

// ============================ التدقيق ============================

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // create, update, delete, approve, cancel...
  entity     String
  entityId   Int
  beforeJson Json?
  afterJson  Json?
  at         DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, at])
}

// ============================ الفروع (§5.16 تعدّد الفروع) ============================

model Branch {
  companyId Int?
  id        Int      @id @default(autoincrement())
  code      String
  nameAr    String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users      User[]
  warehouses Warehouse[]

  @@index([companyId])
  @@index([active])
  @@unique([companyId, code])
}

// ============================ عرض السعر (§5.16) ============================

model Quotation {
  companyId Int?
  id                   Int             @id @default(autoincrement())
  number               String // QT-...
  clientUuid           String?
  customerId           Int
  customer             Customer        @relation(fields: [customerId], references: [id])
  repId                Int?
  rep                  User?           @relation("QuotationRep", fields: [repId], references: [id])
  warehouseId          Int?
  warehouse            Warehouse?      @relation(fields: [warehouseId], references: [id])
  date                 DateTime        @default(now())
  validUntil           DateTime?
  status               QuotationStatus @default(DRAFT)
  subtotal             Decimal         @default(0) @db.Decimal(18, 2)
  discountType         DiscountType?
  discountValue        Decimal?        @db.Decimal(18, 2)
  discountAmount       Decimal         @default(0) @db.Decimal(18, 2)
  shipping             Decimal         @default(0) @db.Decimal(18, 2)
  taxPercent           Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount            Decimal         @default(0) @db.Decimal(18, 2)
  net                  Decimal         @default(0) @db.Decimal(18, 2)
  notes                String?
  createdById          Int
  createdBy            User            @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  approvedById         Int?
  approvedBy           User?           @relation("QuotationApprovedBy", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  periodId             Int?
  period               Period?         @relation(fields: [periodId], references: [id])
  convertedStatementId Int?
  convertedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  lines QuotationLine[]

  @@index([customerId, date])
  @@index([repId, date])
  @@index([periodId])
  @@index([companyId])
  @@index([status])
  @@unique([companyId, number])
  @@unique([companyId, clientUuid])
  @@unique([companyId, convertedStatementId])
}

model QuotationLine {
  id                      Int           @id @default(autoincrement())
  quotationId             Int
  quotation               Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId                  Int
  item                    Item          @relation(fields: [itemId], references: [id])
  unitId                  Int
  unit                    Unit          @relation(fields: [unitId], references: [id])
  factor                  Decimal       @default(1) @db.Decimal(18, 6)
  qty                     Decimal       @db.Decimal(18, 3)
  qtyBase                 Decimal       @db.Decimal(18, 3)
  unitPrice               Decimal       @db.Decimal(18, 4)
  lineDiscountType        DiscountType?
  lineDiscountValue       Decimal?      @db.Decimal(18, 2)
  lineDiscountAmount      Decimal       @default(0) @db.Decimal(18, 2)
  allocatedHeaderDiscount Decimal       @default(0) @db.Decimal(18, 2)
  netLine                 Decimal       @default(0) @db.Decimal(18, 2)
  costSnapshot            Decimal?      @db.Decimal(18, 4)
  periodId                Int?
  createdAt               DateTime      @default(now())

  @@index([quotationId])
  @@index([itemId])
}

// ============================ الأسعار الخاصة (§5.16) ============================

model CustomerGroup {
  companyId Int?
  id            Int            @id @default(autoincrement())
  code          String
  nameAr        String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  customers     Customer[]
  @@index([companyId])
  @@unique([companyId, code])
  specialPrices SpecialPrice[]
}

model SpecialPrice {
  companyId Int?
  id              Int            @id @default(autoincrement())
  itemId          Int
  item            Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitId          Int
  unit            Unit           @relation(fields: [unitId], references: [id])
  priceListId     Int?
  priceList       PriceList?     @relation(fields: [priceListId], references: [id])
  customerId      Int?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerGroupId Int?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  price           Decimal        @db.Decimal(18, 4)
  validFrom       DateTime       @default(now())
  validTo         DateTime?
  active          Boolean        @default(true)
  createdById     Int?
  createdBy       User?          @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())

  @@index([itemId, validFrom])
  @@index([customerId])
  @@index([companyId])
  @@index([customerGroupId])
}

// ============================ تارجت المناديب وعمولات (§5.16) ============================

model RepTarget {
  companyId Int?
  id             Int             @id @default(autoincrement())
  repId          Int
  rep            User            @relation(fields: [repId], references: [id], onDelete: Cascade)
  periodType     RepTargetPeriod @default(MONTHLY)
  fromDate       DateTime        @db.Date
  toDate         DateTime        @db.Date
  targetAmount   Decimal         @db.Decimal(18, 2)
  commissionBase CommissionBase  @default(COLLECTED)
  commissionRate Decimal         @db.Decimal(5, 2)
  achievedAmount Decimal         @default(0) @db.Decimal(18, 2)
  commissionDue  Decimal         @default(0) @db.Decimal(18, 2)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())

  @@index([companyId])
  @@index([repId, fromDate])
}

// ============================ النسخ الاحتياطي التلقائي المشفر (§5.16) ============================

model AutomatedBackup {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  filename    String
  path        String
  sizeBytes   BigInt       @default(0)
  sha256      String
  encrypted   Boolean      @default(true)
  status      BackupStatus @default(RUNNING)
  error       String?
  createdById Int?
  createdBy   User?        @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([status, createdAt])
}

// ============================ الإشعارات والتنبيهات (§5.15) ============================

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // discount_approval | return_approval | low_stock | credit_limit | sync_failed | archive_reminder | backup_reminder
  title     String
  body      String?
  refType   String?
  refId     Int?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// ============================ تحويلات المخازن (§5.7) ============================

model StockTransfer {
  companyId Int?
  id              Int            @id @default(autoincrement())
  number          String // TR-...
  fromWarehouseId Int
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   Int
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  date            DateTime       @default(now())
  status          TransferStatus @default(COMPLETED)
  notes           String?
  createdById     Int?
  periodId        Int?
  createdAt       DateTime       @default(now())

  lines StockTransferLine[]

  @@index([fromWarehouseId, date])
  @@index([companyId])
  @@index([toWarehouseId, date])
  @@unique([companyId, number])
}

model StockTransferLine {
  id         Int           @id @default(autoincrement())
  transferId Int
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId     Int
  item       Item          @relation(fields: [itemId], references: [id])
  batchId    String        @default("")
  qtyBase    Decimal       @db.Decimal(18, 3)
  cost       Decimal?      @db.Decimal(18, 4)

  @@index([transferId])
}

// ============================ أوامر الشراء (§5.5) ============================

model PurchaseOrder {
  companyId Int?
  id             Int                 @id @default(autoincrement())
  number         String // PO-...
  supplierId     Int
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId    Int?
  warehouse      Warehouse?          @relation(fields: [warehouseId], references: [id])
  date           DateTime            @default(now())
  expectedDate   DateTime?           @db.Date
  status         PurchaseOrderStatus @default(DRAFT)
  subtotal       Decimal             @default(0) @db.Decimal(18, 2)
  discountAmount Decimal             @default(0) @db.Decimal(18, 2)
  net            Decimal             @default(0) @db.Decimal(18, 2)
  notes          String?
  createdById    Int?
  approvedById   Int?
  approvedAt     DateTime?
  periodId       Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  lines PurchaseOrderLine[]

  @@index([supplierId, date])
  @@index([companyId])
  @@index([status])
  @@unique([companyId, number])
}

model PurchaseOrderLine {
  id              Int           @id @default(autoincrement())
  orderId         Int
  order           PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId          Int
  item            Item          @relation(fields: [itemId], references: [id])
  unitId          Int
  unit            Unit          @relation(fields: [unitId], references: [id])
  factor          Decimal       @db.Decimal(18, 6)
  qty             Decimal       @db.Decimal(18, 3)
  qtyBase         Decimal       @db.Decimal(18, 3)
  unitPrice       Decimal       @db.Decimal(18, 4)
  lineDiscountType   DiscountType?
  lineDiscountValue  Decimal?      @db.Decimal(18, 2)
  lineDiscountAmount Decimal       @default(0) @db.Decimal(18, 2)
  netLine         Decimal       @db.Decimal(18, 2)
  receivedQtyBase Decimal       @default(0) @db.Decimal(18, 3)

  @@index([orderId])
}

// ============================ مرتجع المشتريات (§5.5) ============================

model SupplierReturn {
  companyId Int?
  id          Int       @id @default(autoincrement())
  number      String // SR-...
  supplierId  Int
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  date        DateTime  @default(now())
  total       Decimal   @db.Decimal(18, 2)
  reason      String?
  notes       String?
  createdById Int?
  periodId    Int?
  createdAt   DateTime  @default(now())

  lines SupplierReturnLine[]

  @@index([companyId])
  @@index([supplierId, date])
  @@unique([companyId, number])
}

model SupplierReturnLine {
  id        Int            @id @default(autoincrement())
  returnId  Int
  return    SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Item           @relation(fields: [itemId], references: [id])
  unitId    Int
  unit      Unit           @relation(fields: [unitId], references: [id])
  qty       Decimal        @db.Decimal(18, 3)
  qtyBase   Decimal        @db.Decimal(18, 3)
  unitPrice Decimal        @db.Decimal(18, 4)
  lineTotal Decimal        @db.Decimal(18, 2)

  @@index([returnId])
}

// ============================ الخزينة والإقفال (§5.10) ============================

model CashAccount {
  companyId Int?
  id             Int             @id @default(autoincrement())
  code           String
  nameAr         String
  type           CashAccountType @default(CASH)
  openingBalance Decimal         @default(0) @db.Decimal(18, 2)
  active         Boolean         @default(true)
  @@index([companyId])
  @@unique([companyId, code])
  createdAt      DateTime        @default(now())

  receipts Receipt[]
  payments Payment[]
}

// محضر تسليم عهدة نقدية من مندوب للخزينة (§5.10)
model CustodyHandover {
  companyId Int?
  id            Int      @id @default(autoincrement())
  number        String // CH-...
  repId         Int
  amount        Decimal  @db.Decimal(18, 2)
  date          DateTime @default(now())
  receivedById  Int?
  cashAccountId Int?
  notes         String?
  status        String   @default("RECEIVED") // RECEIVED | VOID
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([repId, date])
  @@unique([companyId, number])
}

// إقفال يومي للخزينة (§5.10)
model DailyClose {
  companyId Int?
  id             Int      @id @default(autoincrement())
  date           DateTime @db.Date
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  receiptsTotal  Decimal  @default(0) @db.Decimal(18, 2)
  paymentsTotal  Decimal  @default(0) @db.Decimal(18, 2)
  handoversTotal Decimal  @default(0) @db.Decimal(18, 2)
  closingBalance Decimal  @default(0) @db.Decimal(18, 2)
  countedBalance Decimal? @db.Decimal(18, 2)
  difference     Decimal? @db.Decimal(18, 2)
  notes          String?
  closedById     Int?
  @@index([companyId])
  @@unique([companyId, date])
  createdAt      DateTime @default(now())
}

// ============================ خطة الزيارات (§5.12) ============================

model VisitPlan {
  companyId Int?
  id        Int      @id @default(autoincrement())
  repId     Int
  date      DateTime @db.Date
  notes     String?
  createdAt DateTime @default(now())

  lines VisitPlanLine[]

  @@index([companyId])
  @@unique([companyId, repId, date])
}

model VisitPlanLine {
  id         Int         @id @default(autoincrement())
  planId     Int
  plan       VisitPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  customerId Int
  customer   Customer    @relation(fields: [customerId], references: [id])
  sequence   Int         @default(0)
  status     VisitPlanStatus @default(MISSED) // PLANNED→MISSED default, set DONE on visit
  notes      String?

  @@index([planId])
}
